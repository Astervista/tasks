# Shared secret for the web app, the CLI/daemon and the tray apps. Generate with: openssl rand -hex 32
TASKS_TOKEN=change-me-to-a-long-random-secret
# Address/port published on the host. Keep 127.0.0.1 when a reverse proxy on the same host terminates TLS;
# use 0.0.0.0 only on a trusted network.
BIND=127.0.0.1
PORT=8080
# token: everything needs the token (web app included, it asks once).
# proxy: a login service in front of the server guards the web app; requests without a token are
#        trusted, requests with a token (CLI, daemon, tray apps) must use the right one.
AUTH_MODE=token
# Where the workspaces live on the host (one folder per project, plain TODO.md files). Relative to this folder.
DATA_PATH=./data
# Owner of DATA_PATH, the container runs as this user: put the output of `id -u` and `id -g` here.
TASKS_UID=1000
TASKS_GID=1000
