# The reverse proxy's Docker network; the server joins it and publishes no port.
PROXY_NETWORK=proxy_network
# Where the workspaces live on the host (one folder per project, plain TODO.md files). Relative to this folder.
DATA_PATH=./data
# Owner of DATA_PATH, the container runs as this user: put the output of `id -u` and `id -g` here.
TASKS_UID=1000
TASKS_GID=1000
