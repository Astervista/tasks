# Shared secret for the CLI, the daemon, the tray apps and the reverse proxy. Generate with: openssl rand -hex 32
TASKS_TOKEN=change-me-to-a-long-random-secret
# token: every request needs the token (the web app asks for it once, unless a proxy in front adds it).
# proxy: requests without a token are trusted (for a login service that cannot add headers);
#        a token that is sent must still be right.
AUTH_MODE=token
# The reverse proxy's Docker network; the server joins it and publishes no port.
PROXY_NETWORK=proxy_network
# Where the workspaces live on the host (one folder per project, plain TODO.md files). Relative to this folder.
DATA_PATH=./data
# Owner of DATA_PATH, the container runs as this user: put the output of `id -u` and `id -g` here.
TASKS_UID=1000
TASKS_GID=1000
