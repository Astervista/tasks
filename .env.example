# The reverse proxy's Docker network; the server joins it and publishes no port.
PROXY_NETWORK=proxy_network
# Where the workspaces live on the host (one folder per project, plain TODO.md files). Relative to this folder.
DATA_PATH=./data
# Owner of DATA_PATH, the container runs as this user: put the output of `id -u` and `id -g` here.
TASKS_UID=1000
TASKS_GID=1000
# The login service's permission check, reached over the proxy network: the server asks it who each
# request's user is, and whether they have the permission below. Change it only if the service has another name.
AUTH_URL=http://astervista-auth-backend:1000/permission
# The permission a user needs to use tasks; each user with it has their own projects.
AUTH_PERMISSION=tasks
